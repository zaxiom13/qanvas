{
  "name": "qanvas",
  "version": "1.0.0",
  "private": true,
  "description": "Learn q by drawing. A creative-coding studio for the q language, running entirely in your browser.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "oracle": "node tools/oracle.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@lucide/svelte": "^1.48.0",
    "bits-ui": "^2.19.3",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "marked": "^18.0.14",
    "p5": "^2.3.4",
    "paneforge": "^1.0.2"
  }
}
